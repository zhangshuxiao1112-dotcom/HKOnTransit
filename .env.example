# ============================================================================
# HKOnTransit environment configuration template
# ============================================================================
# Copy this file to .env and edit as needed.
# The AI demo runs locally; transport APIs need internet with the default "mock" provider — no keys
# required. To activate the live DeepSeek LLM, set the variables below.
#
# All variables are OPTIONAL. See ai/service.py and ai/adapters/deepseek.py
# for how these are consumed.
#
# Quick start (offline demo):
#   cp .env.example .env        # optional — defaults are already offline
#   ./run.sh
#
# Quick start (live GenAI):
#   cp .env.example .env
#   # Edit .env: set HKONTRANSIT_AI_PROVIDER=deepseek and DEEPSEEK_API_KEY
#   ./run.sh
# ============================================================================

# Provider: "mock" (offline stubs, default) | "deepseek" (live, needs key)
HKONTRANSIT_AI_PROVIDER=mock

# Default output language for AI text
HKONTRANSIT_AI_LANG=en

# Cache structured AI outputs (LLM calls are selective, not continuous)
HKONTRANSIT_AI_CACHE=1
HKONTRANSIT_AI_CACHE_TTL=120
HKONTRANSIT_AI_TIMEOUT=8

# --- DeepSeek (the technical team's target backend) -----------------------
# Required when HKONTRANSIT_AI_PROVIDER=deepseek. Leave blank for mock mode.
# Get an API key at https://platform.deepseek.com/ — a maintainer must fill in
# DEEPSEEK_API_KEY to activate the live model.
# Model id is configurable so a newer "Flash" revision drops in without code.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Transport networking: system reads OS and environment proxies (including macOS).
HKONTRANSIT_NETWORK_MODE=system
# Optional explicit proxy URL. Never include credentials in shared diagnostics.
HKONTRANSIT_PROXY=
# To intentionally connect without a proxy, set HKONTRANSIT_NETWORK_MODE=direct.

# Optional trusted CA bundle provided by your network administrator (PEM).
HKONTRANSIT_CA_FILE=
